# Copy to .env.local for local development. On Vercel add these under
# Project Settings -> Environment Variables. Both are optional.

# Public URL of the deployed site, used for canonical + social-share tags.
# On Vercel it is detected automatically; set it when you add a custom domain.
VITE_SITE_URL=

# Form endpoint that accepts a JSON POST (for example a Formspree form URL:
# https://formspree.io/f/xxxxxxxx). If empty, the contact form validates the
# input and opens the visitor's email app instead of claiming a message was sent.
VITE_CONTACT_ENDPOINT=
